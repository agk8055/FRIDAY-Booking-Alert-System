# ==============================================================================
# BookMyShow Alert System - Preferences & Notifications
# (Movie & Theatre target URLs are configured in targets.json)
# ==============================================================================

# Check interval in seconds (default: 60)
CHECK_INTERVAL_SECONDS=60

# Run Chrome silently in background (true/false)
HEADLESS_BROWSER=true

# Performance & Background Optimization (for running on personal PC)
RECYCLE_BROWSER_CYCLES=50
ECO_PRIORITY=true
ADAPTIVE_POLLING=false

# ==========================================
# Alert Preferences
# ==========================================
SOUND_ALERT=true
WINDOWS_TOAST=true
OPEN_BROWSER_ON_OPEN=true

# ==========================================
# Telegram Alerts (Push to Mobile)
# ==========================================
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ==========================================
# Email Alerts (SMTP)
# ==========================================
EMAIL_ENABLED=false
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_RECIPIENT=

# ==========================================
# Discord Alerts (Optional Webhook)
# ==========================================
DISCORD_ENABLED=false
DISCORD_WEBHOOK_URL=

# ==========================================
# Custom Webhook (Optional)
# ==========================================
WEBHOOK_ENABLED=false
WEBHOOK_URL=

# ==========================================
# Cloud / Render Deployment (Optional)
# ==========================================
# Protect the web dashboard with Basic Auth when hosted publicly
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=
# Optional persistent storage directory (e.g., /data on Render Persistent Disk)
DATA_DIR=
